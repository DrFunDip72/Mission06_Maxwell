@model Movie

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="card shadow-lg">
                <div class="card-header bg-primary text-white">
                    <h2 class="mb-0">@(Model != null && Model.MovieId > 0 ? "Edit Movie" : "Submit a New Movie")</h2>
                </div>
                <div class="card-body p-5">
                    <form method="post" asp-action="Movies" asp-controller="Home" novalidate>
                        @if (Model != null && Model.MovieId > 0)
                        {
                            <input type="hidden" asp-for="MovieId" />
                        }

                        <div class="mb-3">
                            <label asp-for="Title" class="form-label fw-bold">Movie Title <span class="text-danger">*</span></label>
                            <input asp-for="Title" class="form-control form-control-lg" placeholder="Enter movie title" required />
                            <span asp-validation-for="Title" class="text-danger small"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Year" class="form-label fw-bold">Release Year <span class="text-danger">*</span></label>
                            <input asp-for="Year" type="number" class="form-control form-control-lg" placeholder="e.g., 2023" required />
                            <small class="text-muted">Must be 1888 or later</small>
                            <span asp-validation-for="Year" class="text-danger small d-block"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="CategoryId" class="form-label fw-bold">Category</label>
                            <select asp-for="CategoryId" class="form-select form-select-lg">
                                <option value="">-- Select Category --</option>
                                @if (ViewBag.Categories != null)
                                {
                                    foreach (var c in ViewBag.Categories as List<Category>)
                                    {
                                        if (Model != null && Model.CategoryId == c.CategoryId)
                                        {
                                            <option value="@c.CategoryId" selected>@c.CategoryName</option>
                                        }
                                        else
                                        {
                                            <option value="@c.CategoryId">@c.CategoryName</option>
                                        }
                                    }
                                }
                            </select>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Director" class="form-label fw-bold">Director</label>
                            <input asp-for="Director" class="form-control form-control-lg" placeholder="Director name" />
                        </div>

                        <div class="mb-3">
                            <label asp-for="Rating" class="form-label fw-bold">Rating</label>
                            <input asp-for="Rating" class="form-control form-control-lg" placeholder="e.g., PG, PG-13, R" />
                        </div>

                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <div class="form-check form-switch">
                                    <input asp-for="Edited" class="form-check-input" type="checkbox" role="switch" id="editedCheck" />
                                    <label class="form-check-label fw-bold" for="editedCheck">Edited <span class="text-danger">*</span></label>
                                </div>
                                <small class="text-muted">Is this movie edited/censored?</small>
                            </div>
                            <div class="col-md-6 mb-3">
                                <div class="form-check form-switch">
                                    <input asp-for="CopiedToPlex" class="form-check-input" type="checkbox" role="switch" id="plexCheck" />
                                    <label class="form-check-label fw-bold" for="plexCheck">Copied To Plex <span class="text-danger">*</span></label>
                                </div>
                                <small class="text-muted">Has this been added to your Plex server?</small>
                            </div>
                        </div>

                        <div class="mb-3">
                            <label asp-for="LentTo" class="form-label fw-bold">Lent To</label>
                            <input asp-for="LentTo" class="form-control form-control-lg" placeholder="Person's name (optional)" />
                        </div>

                        <div class="mb-3">
                            <label asp-for="Notes" class="form-label fw-bold">Notes</label>
                            <input asp-for="Notes" class="form-control form-control-lg" placeholder="Additional notes (max 25 characters)" maxlength="25" />
                        </div>

                        <div class="d-grid gap-2 d-sm-flex justify-content-sm-center mt-4">
                            <button type="submit" class="btn btn-primary btn-lg px-5">
                                @if (Model != null && Model.MovieId > 0)
                                {
                                    <span>Update Movie</span>
                                }
                                else
                                {
                                    <span>Submit Movie</span>
                                }
                            </button>
                            <a href="@Url.Action("ListMovies", "Home")" class="btn btn-secondary btn-lg px-5">Cancel</a>
                        </div>

                        <!-- Success Message -->
                        @if (TempData["SuccessMessage"] != null)
                        {
                            <div class="alert alert-success alert-dismissible fade show mt-4" role="alert">
                                <i class="bi bi-check-circle-fill"></i> @TempData["SuccessMessage"]
                                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                            </div>
                        }

                        <!-- Error Messages -->
                        @if (TempData["ModelErrors"] != null)
                        {
                            <div class="alert alert-danger alert-dismissible fade show mt-4" role="alert">
                                <strong><i class="bi bi-exclamation-triangle-fill"></i> Validation Errors:</strong>
                                <pre style="white-space: pre-wrap; margin-top: 0.5rem;">@TempData["ModelErrors"]</pre>
                                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                            </div>
                        }

                        @if (!ViewData.ModelState.IsValid && ViewData.ModelState.Values.Any(v => v.Errors.Count > 0))
                        {
                            <div class="alert alert-danger alert-dismissible fade show mt-4" role="alert">
                                <strong><i class="bi bi-exclamation-triangle-fill"></i> Please fix the following errors:</strong>
                                <ul class="mb-0 mt-2">
                                    @foreach (var modelState in ViewData.ModelState.Values)
                                    {
                                        @foreach (var error in modelState.Errors)
                                        {
                                            <li>@error.ErrorMessage</li>
                                        }
                                    }
                                </ul>
                                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                            </div>
                        }
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>


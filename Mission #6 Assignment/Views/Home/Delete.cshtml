@model Movie

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-lg-6">
            <div class="card border-danger shadow-lg">
                <div class="card-header bg-danger text-white">
                    <h3 class="mb-0"><i class="bi bi-exclamation-triangle"></i> Confirm Delete</h3>
                </div>
                <div class="card-body p-5">
                    <div class="alert alert-warning" role="alert">
                        <strong>Warning:</strong> This action cannot be undone!
                    </div>
                    
                    <p class="mb-3">Are you sure you want to delete this movie?</p>
                    
                    <div class="card bg-light mb-4">
                        <div class="card-body">
                            <h5 class="card-title">@Model.Title</h5>
                            <p class="card-text mb-2">
                                <strong>Year:</strong> @Model.Year<br />
                                @if (!string.IsNullOrEmpty(Model.Director))
                                {
                                    <span><strong>Director:</strong> @Model.Director<br /></span>
                                }
                                @if (Model.Category != null)
                                {
                                    <span><strong>Category:</strong> @Model.Category.CategoryName</span>
                                }
                            </p>
                        </div>
                    </div>

                    <form method="post" asp-action="Delete" asp-controller="Home">
                        <input type="hidden" name="id" asp-for="MovieId" />
                        <div class="d-grid gap-2 d-sm-flex justify-content-sm-center">
                            <button type="submit" class="btn btn-danger btn-lg px-5">
                                <i class="bi bi-trash"></i> Yes, Delete Movie
                            </button>
                            <a class="btn btn-secondary btn-lg px-5" asp-controller="Home" asp-action="ListMovies">
                                <i class="bi bi-x-circle"></i> Cancel
                            </a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
@model List<Movie>

<div class="container mt-5">
    <div class="row mb-4">
        <div class="col-md-8">
            <h1 class="page-title">🎬 Movie Collection</h1>
        </div>
        <div class="col-md-4 text-end">
            <a href="@Url.Action("Movies", "Home")" class="btn btn-primary btn-lg">
                <i class="bi bi-plus-circle"></i> Add New Movie
            </a>
        </div>
    </div>

    <!-- Success/Error Messages -->
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="bi bi-check-circle-fill"></i> @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <i class="bi bi-exclamation-triangle-fill"></i> @TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <!-- Movies Table -->
    <div class="card shadow-lg">
        <div class="card-header bg-primary text-white">
            <h5 class="mb-0">Total Movies: <span class="badge bg-light text-dark">@Model.Count</span></h5>
        </div>
        <div class="table-responsive">
            <table class="table table-hover mb-0">
                <thead>
                    <tr>
                        <th scope="col" style="width: 10%;">ID</th>
                        <th scope="col" style="width: 20%;">Title</th>
                        <th scope="col" style="width: 12%;">Year</th>
                        <th scope="col" style="width: 15%;">Category</th>
                        <th scope="col" style="width: 12%;">Director</th>
                        <th scope="col" style="width: 8%;">Rating</th>
                        <th scope="col" style="width: 8%;">Edited</th>
                        <th scope="col" style="width: 10%;">Plex</th>
                        <th scope="col" style="width: 30%;">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Count > 0)
                    {
                        @foreach (var movie in Model)
                        {
                            <tr>
                                <td><span class="badge bg-info">@movie.MovieId</span></td>
                                <td>
                                    <strong>@movie.Title</strong>
                                </td>
                                <td>@movie.Year</td>
                                <td>
                                    @if (movie.Category != null)
                                    {
                                        <span class="badge bg-secondary">@movie.Category.CategoryName</span>
                                    }
                                    else
                                    {
                                        <span class="text-muted">-</span>
                                    }
                                </td>
                                <td>@(string.IsNullOrEmpty(movie.Director) ? "-" : movie.Director)</td>
                                <td>
                                    @if (!string.IsNullOrEmpty(movie.Rating))
                                    {
                                        <span class="badge bg-warning text-dark">@movie.Rating</span>
                                    }
                                    else
                                    {
                                        <span class="text-muted">-</span>
                                    }
                                </td>
                                <td>
                                    @if (movie.Edited)
                                    {
                                        <span class="badge bg-success">Yes</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-danger">No</span>
                                    }
                                </td>
                                <td>
                                    @if (movie.CopiedToPlex)
                                    {
                                        <span class="badge bg-success">Yes</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-warning text-dark">No</span>
                                    }
                                </td>
                                <td>
                                    <a href="@Url.Action("Edit", "Home", new { id = movie.MovieId })" class="btn btn-sm btn-info text-white">
                                        <i class="bi bi-pencil"></i> Edit
                                    </a>
                                    <a href="@Url.Action("Delete", "Home", new { id = movie.MovieId })" class="btn btn-sm btn-danger">
                                        <i class="bi bi-trash"></i> Delete
                                    </a>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="9" class="text-center py-4 text-muted">
                                <p>No movies found. <a href="@Url.Action("Movies", "Home")">Add your first movie</a>!</p>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    <!-- Additional Info -->
    <div class="row mt-4">
        <div class="col-md-12">
            <div class="card bg-light">
                <div class="card-body">
                    <p class="mb-0"><strong>Tip:</strong> Use the "Add New Movie" button to add movies to your collection. Click "Edit" to modify any movie details, or "Delete" to remove a movie.</p>
                </div>
            </div>
        </div>
    </div>
</div>
